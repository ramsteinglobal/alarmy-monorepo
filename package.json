{
  "name": "Wakely",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "react-native start --host 0.0.0.0",
    "android:build:debug": "node scripts/build-apk.mjs --mode=debug",
    "android:build:debug:all": "node scripts/build-apk.mjs --mode=debug --arch=all",
    "android:serve:apk": "python3 -m http.server 8082 --bind 0.0.0.0 --directory android/app/build/outputs/apk/debug",
    "android:build:release": "node scripts/build-apk.mjs --mode=release",
    "android:build:release:all": "node scripts/build-apk.mjs --mode=release --arch=all",
    "android:clean": "node scripts/build-apk.mjs --clean-only",
    "android:install:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:deploy:debug": "npm run android:build:debug && npm run android:install:debug",
    "android:launch": "adb shell am start -n com.alarmyapp/com.alarmyapp.MainActivity",
    "doctor": "node scripts/doctor.mjs",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "react-native start",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.frontend.json",
    "backend:install": "npm ci --prefix backend/functions",
    "backend:build": "npm --prefix backend/functions run build",
    "backend:lint": "npm --prefix backend/functions run lint",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test -- --passWithNoTests --watch=false && npm run backend:install && npm run backend:build",
    "ci:local": "npm run verify && npm run android:build:debug"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.28.0",
    "react-native-sensors": "^7.3.6",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
